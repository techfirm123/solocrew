{
  "name": "solocrew",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.29.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.29.0 <12"
  },
  "scripts": {
    "check:workspace": "pnpm --recursive list --depth -1",
